datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PaybackStatus {
  PENDING
  PAID
  REJECTED
}

model Settlement {
  id                Int              @id @default(autoincrement())
  orderNo           String
  campaignName      String
  buyerName         String
  buyerPhone        String?
  purchaseAmount    Int
  paybackAmount     Int
  paybackStatus     PaybackStatus    @default(PENDING)
  bankName          String
  bankAccountNumber String
  bankAccountHolder String
  memo              String?
  extraFields       Json?
  rejectedReason    String?
  sourceFile        String?
  paidAt            DateTime?
  groupId           Int?
  group             SettlementGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([orderNo, campaignName])
  @@index([paybackStatus])
  @@index([groupId])
}

model SettlementGroup {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  memo        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  settlements Settlement[]
}

model ImportMapping {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  mapping   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TargetField {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  required  Boolean  @default(false)
  isBuiltIn Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
